---
import MainGridLayout from '@layouts/MainGridLayout.astro'
import RhineMark from '@components/rhine/RhineMark.astro'
import { rhineOperators } from '../data/operators'
import { getPostUrlBySlug, url } from '@utils/url-utils'

const featured = rhineOperators.filter(operator =>
  ['muelsyse', 'saria', 'dorothy'].includes(operator.slug),
)
const artSize: Record<string, { width: number; height: number }> = {
  muelsyse: { width: 1400, height: 1323 },
  saria: { width: 1400, height: 1400 },
  dorothy: { width: 1400, height: 1400 },
  silence: { width: 1317, height: 1186 },
  ifrit: { width: 1400, height: 1400 },
  ptilopsis: { width: 1024, height: 1024 },
  mayer: { width: 1400, height: 1400 },
  magallan: { width: 1400, height: 1400 },
}
const star = (count: number) => '★'.repeat(count)

const divisions = [
  { key: 'all', label: 'ALL / 全部科室', count: rhineOperators.length },
  {
    key: 'defense',
    label: 'DEFENSE / 防卫科',
    count: rhineOperators.filter(o => o.divisionKey === 'defense').length,
  },
  {
    key: 'clinical',
    label: 'CLINICAL / 临床与神经',
    count: rhineOperators.filter(o => o.divisionKey === 'clinical').length,
  },
  {
    key: 'ecology',
    label: 'ECOLOGY / 生态与科考',
    count: rhineOperators.filter(o => o.divisionKey === 'ecology').length,
  },
  {
    key: 'engineering',
    label: 'ENGINEERING / 结构与工程',
    count: rhineOperators.filter(o => o.divisionKey === 'engineering').length,
  },
]

const serializedOperators = JSON.stringify(
  rhineOperators.map(operator => ({
    ...operator,
    cardUrl: url(operator.card),
    artUrl: url(operator.art),
    artWidth: artSize[operator.slug]?.width ?? 1400,
    artHeight: artSize[operator.slug]?.height ?? 1400,
    relatedUrl: getPostUrlBySlug(operator.relatedSlug),
  })),
)
---

<MainGridLayout
  title="研究员名录"
  description="莱茵生命研究员名录：8 位干员的代号、科室、权限等级、实验参数与机密批注，支持按科室筛选与站内卷宗深度调阅。"
>
  <section class="rl-ops-hero" aria-labelledby="rl-ops-title">
    <div class="rl-ops-hero__grid" aria-hidden="true"></div>
    <div class="rl-ops-hero__head">
      <p class="rl-kicker"><RhineMark size={16} /> RHINE LAB / PERSONNEL REGISTRY</p>
      <h1 id="rl-ops-title" class="rl-ops-hero__title">研究员名录<em>.</em></h1>
      <p class="rl-ops-hero__en">OPERATORS · COLUMBIA BRANCH · RL-01 → RL-08</p>
      <p class="rl-ops-hero__lede">
        八份仍在更新的人事档案。支持按莱茵生命科室频段筛选、显影被涂改的内部实验批注，
        或唤起站内「人事卷宗检视终端」调阅三项实验参数与关联研究文章。
      </p>
      <div class="rl-ops-hero__stats">
        <div><span>RECORDS / 档案</span><b>08</b></div>
        <div><span>DIVISIONS / 科室</span><b>04</b></div>
        <div><span>CLEARANCE / 最高权限</span><b>LV.5 DIRECTOR</b></div>
        <div><span>STATUS / 状态</span><b class="rl-live">INTERACTIVE</b></div>
      </div>
    </div>
    <div class="rl-ops-hero__side" aria-hidden="true">
      <img src={url('/rhine/art/art-muelsyse.webp')} alt="" width="1400" height="1323" />
    </div>
  </section>

  <section class="rl-feature" aria-labelledby="rl-feature-title">
    <div class="rl-section-head">
      <p class="rl-kicker">DIRECTORS / 主任级重点卷宗</p>
      <h2 id="rl-feature-title">三份优先调阅</h2>
      <p>三位主任级研究员的立绘档案。点击可直接打开站内深度卷宗检视器，查看实验指标与内部批注。</p>
    </div>
    <div class="rl-feature__grid">
      {
        featured.map((operator, index) => (
          <article class:list={['rl-figure', `rl-figure--${operator.slug}`]} style={`--i:${index}`}>
            <button
              type="button"
              class="rl-figure__link rl-figure__trigger"
              data-op-inspect={operator.slug}
              aria-label={`调阅 ${operator.cn}（${operator.code}）深度档案`}
            >
              <span class="rl-figure__frame">
                <img
                  src={url(operator.art)}
                  alt={`${operator.cn}立绘`}
                  width={artSize[operator.slug].width}
                  height={artSize[operator.slug].height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                />
              </span>
              <span class="rl-figure__badge">{operator.clearance}</span>
              <span class="rl-figure__meta">
                <span class="rl-figure__code">{operator.code} / {operator.en}</span>
                <span class="rl-figure__name">{operator.cn}</span>
                <span class="rl-figure__role">{operator.division} · {operator.profession}</span>
                <span class="rl-figure__cta">INSPECT DOSSIER / 调阅卷宗 →</span>
              </span>
            </button>
          </article>
        ))
      }
    </div>
  </section>

  <section class="rl-roster" aria-labelledby="rl-roster-title">
    <div class="rl-section-head">
      <p class="rl-kicker">ROSTER &amp; TERMINAL / 全员名录与科室检索</p>
      <h2 id="rl-roster-title">八份人事档案</h2>
      <p>按档案编号排列。可按科室或关键词筛选，点击黑条可显影内部批注，点击「调阅卷宗」打开完整参数终端。</p>
    </div>

    <div class="rl-ops-console card-base" role="region" aria-label="研究员档案筛选控制台">
      <div class="rl-ops-console__tabs" role="group" aria-label="按科室筛选">
        {
          divisions.map((div, idx) => (
            <button
              type="button"
              class:list={['rl-ops-tab', { 'is-active': idx === 0 }]}
              data-div-filter={div.key}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              <span>{div.label}</span>
              <b>{String(div.count).padStart(2, '0')}</b>
            </button>
          ))
        }
      </div>
      <div class="rl-ops-console__bar">
        <label class="sr-only" for="rl-ops-search">检索研究员代号、姓名或标签</label>
        <input
          id="rl-ops-search"
          class="rl-ops-console__input"
          type="search"
          placeholder="输入代号（如 RL-01 / 塞雷娅 / 源石技艺 / 临床）即时过滤…"
          autocomplete="off"
        />
        <span id="rl-ops-count" class="rl-ops-console__count" role="status" aria-live="polite">
          SHOWING 08 / 08 DOSSIERS
        </span>
        <button
          type="button"
          id="rl-ops-declassify-all"
          class="rl-ops-console__action"
          aria-pressed="false"
        >
          DECLASSIFY ALL / 显影全部批注
        </button>
      </div>
    </div>

    <p id="rl-ops-empty" class="rl-ops-empty card-base" hidden>
      未找到匹配该科室或关键词的研究员档案。请尝试切换上方科室频段或清空搜索词。
    </p>

    <div class="rl-roster__grid" id="rl-roster-grid">
      {
        rhineOperators.map(operator => (
          <article
            class="rl-dossier"
            id={operator.code}
            data-op-card={operator.slug}
            data-op-div={operator.divisionKey}
            data-op-search={`${operator.code} ${operator.cn} ${operator.en} ${operator.role} ${operator.division} ${operator.profession} ${operator.tags.join(' ')}`.toLowerCase()}
          >
            <div class="rl-dossier__card">
              <div class="rl-dossier__top">
                <span class="rl-dossier__code">{operator.code} · {operator.division.split('/')[0].trim()}</span>
                <span class="rl-dossier__rarity" aria-label={`${operator.rarity} 星`}>{star(operator.rarity)}</span>
              </div>

              <button
                type="button"
                class="rl-dossier__figure rl-dossier__inspect-trigger"
                data-op-inspect={operator.slug}
                aria-label={`打开 ${operator.cn}（${operator.code}）卷宗检视终端`}
              >
                <img
                  src={url(operator.card)}
                  alt={`${operator.cn}档案立绘`}
                  width="700"
                  height="700"
                  loading="lazy"
                />
                <span class="rl-dossier__ clearance-pill">{operator.clearance}</span>
                <span class="rl-dossier__scan-hint">INSPECT // 检视</span>
              </button>

              <div class="rl-dossier__body">
                <div class="rl-dossier__names">
                  <h3 class="rl-dossier__cn">{operator.cn}</h3>
                  <span class="rl-dossier__en">{operator.en}</span>
                </div>
                <p class="rl-dossier__role">{operator.role} · {operator.profession}</p>
                <p class="rl-dossier__note">{operator.note}</p>

                <div class="rl-dossier__metrics" aria-label={`${operator.cn}实验指标`}>
                  {operator.metrics.map(m => (
                    <div class="rl-dossier__metric">
                      <div class="rl-dossier__metric-head">
                        <span>{m.label}</span>
                        <b>{m.value}%</b>
                      </div>
                      <span class="rl-dossier__metric-bar" style={`--w:${m.value}%`}><i /></span>
                    </div>
                  ))}
                </div>

                <button
                  type="button"
                  class="rl-dossier__redact"
                  data-redact-toggle
                  aria-pressed="false"
                  aria-label={`显影或隐藏 ${operator.cn} 的内部涂改批注`}
                >
                  <span class="rl-dossier__redact-tag">CLASSIFIED NOTE // 点击显影</span>
                  <span class="rl-dossier__redact-text">{operator.redacted}</span>
                </button>

                <div class="rl-dossier__tags">
                  {operator.tags.map(tag => <span class="rl-dossier__tag">{tag}</span>)}
                </div>
              </div>

              <div class="rl-dossier__foot">
                <button
                  type="button"
                  class="rl-dossier__btn"
                  data-op-inspect={operator.slug}
                >
                  调阅卷宗 / DOSSIER
                </button>
                <a
                  class="rl-dossier__ext"
                  href={operator.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${operator.cn} 外部 Wiki 资料`}
                >
                  WIKI ↗
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 站内人事档案深度检视弹窗 -->
  <div
    id="rl-dossier-modal"
    class="rl-dmodal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="rl-dmodal-title"
    hidden
  >
    <div class="rl-dmodal__panel">
      <header class="rl-dmodal__head">
        <div class="rl-dmodal__id">
          <span class="rl-kicker" id="rl-dmodal-code">RL-01 // PERSONNEL DOSSIER</span>
          <span class="rl-dmodal__clearance" id="rl-dmodal-clearance">LV.5 · DIRECTOR</span>
        </div>
        <div class="rl-dmodal__nav">
          <button type="button" class="rl-dmodal__nav-btn" id="rl-dmodal-prev" aria-label="上一份研究员档案">← PREV</button>
          <button type="button" class="rl-dmodal__nav-btn" id="rl-dmodal-next" aria-label="下一份研究员档案">NEXT →</button>
          <button type="button" class="rl-dmodal__close" id="rl-dmodal-close" aria-label="关闭档案检视器">× CLOSE</button>
        </div>
      </header>

      <div class="rl-dmodal__grid">
        <div class="rl-dmodal__art-wrap">
          <img
            id="rl-dmodal-img"
            src={url('/rhine/art/art-saria.webp')}
            alt="塞雷娅完整立绘"
            width="1400"
            height="1400"
          />
          <span class="rl-dmodal__stamp" id="rl-dmodal-division">DEFENSE / 防卫科</span>
        </div>

        <div class="rl-dmodal__info">
          <div class="rl-dmodal__title-row">
            <h2 class="rl-dmodal__title" id="rl-dmodal-title">塞雷娅</h2>
            <span class="rl-dmodal__en" id="rl-dmodal-en">SARIA</span>
            <span class="rl-dmodal__stars" id="rl-dmodal-stars">★★★★★★</span>
          </div>
          <p class="rl-dmodal__role" id="rl-dmodal-role">防卫科主任 · 重装 / DEFENDER</p>
          <p class="rl-dmodal__note" id="rl-dmodal-note"></p>

          <div class="rl-dmodal__section">
            <p class="rl-kicker">TELEMETRY METRICS / 实测参数</p>
            <div class="rl-dmodal__metrics" id="rl-dmodal-metrics"></div>
          </div>

          <div class="rl-dmodal__section rl-dmodal__section--classified">
            <p class="rl-kicker">DECLASSIFIED ANNOTATION / 内部解密批注</p>
            <p class="rl-dmodal__redacted" id="rl-dmodal-redacted"></p>
          </div>

          <div class="rl-dmodal__section">
            <p class="rl-kicker">RELATED ARCHIVE / 关联本站研究卷宗</p>
            <a class="rl-dmodal__related" id="rl-dmodal-related" href={url('/posts/campus-running-app-audit/')}>
              <span id="rl-dmodal-related-title">某校园跑步 App 安卓客户端安全审计：从静态还原到实机验证</span>
              <span aria-hidden="true">调阅文章 →</span>
            </a>
          </div>

          <div class="rl-dmodal__actions">
            <a
              id="rl-dmodal-wiki"
              class="rl-btn rl-btn--solid"
              href="https://arknights.wiki.gg/wiki/Saria"
              target="_blank"
              rel="noopener noreferrer"
            >
              前往外部 WIKI 履历 <span aria-hidden="true">↗</span>
            </a>
            <button type="button" class="rl-btn" id="rl-dmodal-copy">
              复制档案直达链接
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="rl-ops-note card-base">
    <p class="rl-kicker">NOTICE / 使用说明</p>
    <h2>关于素材</h2>
    <p>
      本页人物立绘来自公开的明日方舟素材归档（Aceship/Arknight-Images），版权归鹰角网络（Hypergryph）所有，
      仅用于<strong>非商业</strong>的同人风格演示；不构成官方合作或授权。若你要把本模板用于商业用途，
      请自行替换为拥有授权的素材。组织名、角色名与设定相关权利均归原权利人所有。
    </p>
    <p class="rl-ops-note__links">
      <a href={url('/about/')}>关于这座档案室</a>
      <a href={url('/archive/')}>全部条目</a>
      <a href={url('/colophon/')}>制作说明</a>
    </p>
  </section>
</MainGridLayout>

<script is:inline define:vars={{ serializedOperators }}>
  ;(() => {
    const operators = JSON.parse(serializedOperators)
    const initOperatorsPage = () => {
      const grid = document.getElementById('rl-roster-grid')
      if (!grid || grid.dataset.rlBound === '1') return
      grid.dataset.rlBound = '1'

      const cards = [...grid.querySelectorAll('[data-op-card]')]
      const tabs = [...document.querySelectorAll('[data-div-filter]')]
      const searchInput = document.getElementById('rl-ops-search')
      const countEl = document.getElementById('rl-ops-count')
      const emptyEl = document.getElementById('rl-ops-empty')
      const declassifyAllBtn = document.getElementById('rl-ops-declassify-all')

      let currentDiv = 'all'
      let allDeclassified = false

      const applyFilter = () => {
        const query = (searchInput?.value || '').trim().toLowerCase()
        let visible = 0
        for (const card of cards) {
          const divMatch = currentDiv === 'all' || card.dataset.opDiv === currentDiv
          const textMatch = !query || (card.dataset.opSearch || '').includes(query)
          const show = divMatch && textMatch
          card.hidden = !show
          if (show) visible += 1
        }
        if (countEl) {
          countEl.textContent = `SHOWING ${String(visible).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')} DOSSIERS`
        }
        if (emptyEl) emptyEl.hidden = visible > 0
      }

      for (const tab of tabs) {
        tab.addEventListener('click', () => {
          currentDiv = tab.dataset.divFilter || 'all'
          for (const t of tabs) {
            const active = t === tab
            t.classList.toggle('is-active', active)
            t.setAttribute('aria-pressed', active ? 'true' : 'false')
          }
          applyFilter()
        })
      }

      searchInput?.addEventListener('input', applyFilter)

      // 涂改黑条点击显影
      for (const btn of document.querySelectorAll('[data-redact-toggle]')) {
        btn.addEventListener('click', () => {
          const revealed = btn.classList.toggle('is-revealed')
          btn.setAttribute('aria-pressed', revealed ? 'true' : 'false')
        })
      }

      declassifyAllBtn?.addEventListener('click', () => {
        allDeclassified = !allDeclassified
        declassifyAllBtn.setAttribute('aria-pressed', allDeclassified ? 'true' : 'false')
        declassifyAllBtn.textContent = allDeclassified
          ? 'CLASSIFY ALL / 恢复涂改掩码'
          : 'DECLASSIFY ALL / 显影全部批注'
        for (const btn of document.querySelectorAll('[data-redact-toggle]')) {
          btn.classList.toggle('is-revealed', allDeclassified)
          btn.setAttribute('aria-pressed', allDeclassified ? 'true' : 'false')
        }
      })

      // 卷宗检视弹窗
      const modal = document.getElementById('rl-dossier-modal')
      const closeBtn = document.getElementById('rl-dmodal-close')
      const prevBtn = document.getElementById('rl-dmodal-prev')
      const nextBtn = document.getElementById('rl-dmodal-next')
      const copyBtn = document.getElementById('rl-dmodal-copy')
      let currentIndex = 0
      let lastFocus = null

      const renderModal = index => {
        currentIndex = (index + operators.length) % operators.length
        const op = operators[currentIndex]
        if (!op) return
        const setText = (id, val) => {
          const el = document.getElementById(id)
          if (el) el.textContent = val
        }
        setText('rl-dmodal-code', `${op.code} // PERSONNEL DOSSIER`)
        setText('rl-dmodal-clearance', op.clearance)
        setText('rl-dmodal-division', op.division)
        setText('rl-dmodal-title', op.cn)
        setText('rl-dmodal-en', op.en)
        setText('rl-dmodal-stars', '★'.repeat(op.rarity))
        setText('rl-dmodal-role', `${op.role} · ${op.profession} / ${op.professionEn}`)
        setText('rl-dmodal-note', op.note)
        setText('rl-dmodal-redacted', op.redacted)
        setText('rl-dmodal-related-title', op.relatedTitle)

        const img = document.getElementById('rl-dmodal-img')
        if (img) {
          img.setAttribute('src', op.artUrl)
          img.setAttribute('alt', `${op.cn}完整立绘`)
          img.setAttribute('width', String(op.artWidth))
          img.setAttribute('height', String(op.artHeight))
        }
        const related = document.getElementById('rl-dmodal-related')
        if (related) related.setAttribute('href', op.relatedUrl)
        const wiki = document.getElementById('rl-dmodal-wiki')
        if (wiki) wiki.setAttribute('href', op.link)

        const metricsWrap = document.getElementById('rl-dmodal-metrics')
        if (metricsWrap) {
          metricsWrap.innerHTML = op.metrics
            .map(
              m => `
              <div class="rl-dmodal__metric">
                <div class="rl-dmodal__metric-head"><span>${m.label}</span><b>${m.value}%</b></div>
                <div class="rl-dmodal__metric-bar"><i style="width:${m.value}%"></i></div>
              </div>
            `,
            )
            .join('')
        }
      }

      const openModal = slug => {
        const idx = operators.findIndex(o => o.slug === slug || o.code.toLowerCase() === slug.toLowerCase())
        if (idx === -1 || !modal) return
        lastFocus = document.activeElement
        renderModal(idx)
        modal.hidden = false
        document.documentElement.classList.add('rl-modal-open')
        closeBtn?.focus()
      }

      const closeModal = () => {
        if (!modal || modal.hidden) return
        modal.hidden = true
        document.documentElement.classList.remove('rl-modal-open')
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus()
      }

      for (const trigger of document.querySelectorAll('[data-op-inspect]')) {
        trigger.addEventListener('click', () => {
          const slug = trigger.getAttribute('data-op-inspect')
          if (slug) openModal(slug)
        })
      }

      closeBtn?.addEventListener('click', closeModal)
      prevBtn?.addEventListener('click', () => renderModal(currentIndex - 1))
      nextBtn?.addEventListener('click', () => renderModal(currentIndex + 1))
      modal?.addEventListener('click', event => {
        if (event.target === modal) closeModal()
      })

      copyBtn?.addEventListener('click', async () => {
        const op = operators[currentIndex]
        if (!op) return
        const shareUrl = new URL(window.location.href)
        shareUrl.searchParams.set('op', op.slug)
        try {
          await navigator.clipboard.writeText(shareUrl.href)
          copyBtn.textContent = '已复制卷宗链接 ✔'
          window.setTimeout(() => {
            copyBtn.textContent = '复制档案直达链接'
          }, 1600)
        } catch {
          /* 忽略剪贴板权限错误 */
        }
      })

      window.addEventListener('keydown', event => {
        if (!modal || modal.hidden) return
        if (event.key === 'Escape') {
          event.preventDefault()
          closeModal()
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault()
          renderModal(currentIndex - 1)
        } else if (event.key === 'ArrowRight') {
          event.preventDefault()
          renderModal(currentIndex + 1)
        }
      })

      // 支持 ?op=saria 或 #RL-01 自动打开对应干员检视器
      try {
        const params = new URLSearchParams(window.location.search)
        const opParam = params.get('op')
        const hashParam = window.location.hash.replace(/^#/, '')
        if (opParam) openModal(opParam)
        else if (/^RL-0[1-8]$/i.test(hashParam)) openModal(hashParam)
      } catch {
        /* 忽略 URL 解析异常 */
      }
    }

    initOperatorsPage()
    document.addEventListener('astro:page-load', initOperatorsPage)
    document.addEventListener('astro:after-swap', initOperatorsPage)
  })()
</script>
