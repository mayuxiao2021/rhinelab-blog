---
import path from 'node:path'
import { render } from 'astro:content'
import License from '@components/misc/License.astro'
import Markdown from '@components/misc/Markdown.astro'
import Giscus from '@components/widget/Giscus.svelte'
import I18nKey from '@i18n/i18nKey'
import { i18n } from '@i18n/translation'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import { getCategoryUrl, getDir, getPostUrlBySlug, url } from '@utils/url-utils'
import RhineSeries from '@components/rhine/RhineSeries.astro'
import RhineShare from '@components/rhine/RhineShare.astro'
import { getSortedPosts } from '@utils/content-utils'
import { Icon } from 'astro-icon/components'
import { licenseConfig } from 'src/config'
import PostMetadata from '../../components/PostMeta.astro'
import RhineToc from '../../components/rhine/RhineToc.astro'
import RhineProgress from '../../components/rhine/RhineProgress.astro'
import RhineRelated from '../../components/rhine/RhineRelated.astro'
import RhineCodeCopy from '../../components/rhine/RhineCodeCopy.astro'
import ImageWrapper from '../../components/misc/ImageWrapper.astro'
import { profileConfig, siteConfig } from '../../config'

export async function getStaticPaths() {
  // 必须走 getSortedPosts：它会把上一篇/下一篇的 slug 与标题写回 entry.data
  // （此前直接用 getCollection，导致上下篇导航永远是空的）
  const blogEntries = await getSortedPosts()
  return blogEntries.map(entry => ({
    params: { slug: entry.id.replace(/\/index$/, '') },
    props: { entry, posts: blogEntries },
  }))
}

const { entry, posts } = Astro.props
const postSlug = entry.id.replace(/\/index$/, '')
const siteOrigin = (Astro.site ?? new URL('https://example.com')).origin
const ogImage = new URL(
  url(`/og/${entry.id.replace(/\/index$/, '').replaceAll('/', '-')}.png`),
  siteOrigin,
).href
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL(url('/'), siteOrigin).href },
    { '@type': 'ListItem', position: 2, name: '归档', item: new URL(url('/archive/'), siteOrigin).href },
    ...(entry.data.category
      ? [
          {
            '@type': 'ListItem',
            position: 3,
            name: entry.data.category,
            item: new URL(getCategoryUrl(entry.data.category), siteOrigin).href,
          },
          {
            '@type': 'ListItem',
            position: 4,
            name: entry.data.title,
            item: new URL(url(`/posts/${postSlug}/`), siteOrigin).href,
          },
        ]
      : [
          {
            '@type': 'ListItem',
            position: 3,
            name: entry.data.title,
            item: new URL(url(`/posts/${postSlug}/`), siteOrigin).href,
          },
        ]),
  ],
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description || entry.data.title,
  keywords: entry.data.tags,
  author: {
    '@type': 'Person',
    name: profileConfig.name,
    url: Astro.site,
  },
  publisher: { '@type': 'Organization', name: siteConfig.title },
  datePublished: entry.data.published.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.published).toISOString(),
  inLanguage: siteConfig.lang.replace('_', '-'),
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(url(Astro.url.pathname), siteOrigin).href },
  image: [ogImage],
  wordCount: Number(remarkPluginFrontmatter.words ?? 0),
}
---
<MainGridLayout
    banner={entry.data.image}
    title={entry.data.title}
    description={entry.data.description}
    image={url(`/og/${entry.id.replace(/\/index$/, '').replaceAll('/', '-')}.png`)}
>
    <RhineProgress headings={headings} />
    <RhineCodeCopy />
    <Fragment slot="head">
      <meta property="article:published_time" content={entry.data.published.toISOString()} />
      <meta property="article:modified_time" content={(entry.data.updated ?? entry.data.published).toISOString()} />
      <meta property="article:section" content={entry.data.category || '未分类'} />
      <meta property="article:author" content={profileConfig.name} />
      {entry.data.tags?.map(tag => <meta property="article:tag" content={tag} />)}
    </Fragment>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" data-pagefind-body class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <div class="sr-only" aria-hidden="true" data-pagefind-ignore>
                <span data-pagefind-filter="category">{entry.data.category || 'UNCATEGORIZED'}</span>
                {entry.data.tags.map(tag => (
                    <span data-pagefind-filter="tag">{tag}</span>
                ))}
            </div>
            <div class="rl-print-head" aria-hidden="true">
                <span class="rl-print-head__site">{siteConfig.title}</span>
                <span>{entry.data.title}</span>
                <span>{entry.data.published.toISOString().slice(0, 10)}</span>
                <span>{new URL(url(`/posts/${postSlug}/`), siteOrigin).href}</span>
            </div>
            <nav class="rl-breadcrumb" aria-label="面包屑" data-pagefind-ignore>
                <a href={url('/')}>首页</a>
                <span aria-hidden="true">/</span>
                <a href={url('/archive/')}>归档</a>
                {entry.data.category && (
                    <>
                        <span aria-hidden="true">/</span>
                        <a href={getCategoryUrl(entry.data.category)}>{entry.data.category}</a>
                    </>
                )}
                <span aria-hidden="true">/</span>
                <span class="rl-breadcrumb__current" aria-current="page">{entry.data.title}</span>
            </nav>
            <!-- word count and reading time -->
            <div class="rl-post__stats flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation" data-pagefind-ignore>
                <div class="flex flex-row items-center">
                    <div class="rl-post__stat transition h-6 w-6 rounded-md flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="rl-post__stat transition h-6 w-6 rounded-md flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.minutes} {" " + i18n(I18nKey.minutesCount)}</div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <h1
                    data-pagefind-weight="10" data-pagefind-meta="title"
                    class="rl-post__title transition w-full block font-bold mb-3
                    text-black/90 dark:text-white/90
                ">
                    {entry.data.title}
                </h1>
            </div>

            <!-- metadata -->
            <div class="onload-animation" data-pagefind-ignore>
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- 目录 / 实验步骤 -->
            <RhineToc headings={headings} />

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} class="mb-8 rounded-xl banner-container onload-animation"/>
            }


            <Markdown class="mb-6 markdown-content onload-animation rl-prose">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={entry.data.title} pubDate={entry.data.published} class="rl-license mb-6 rounded-xl license-container onload-animation" data-pagefind-ignore></License>}

            <!-- 分享 / SHARE -->
            <RhineShare title={entry.data.title} published={entry.data.published} />

            <!-- 系列 / SERIES -->
            <RhineSeries posts={posts} entry={entry} />

            <!-- 相关档案 / RELATED -->
            <RhineRelated id={entry.id} category={entry.data.category} tags={entry.data.tags} />

            <!-- Giscus Comments -->
            <div class="onload-animation" data-pagefind-ignore style="animation-delay: calc(var(--content-delay) + 375ms)">
                <Giscus client:load />
            </div>

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full" data-pagefind-ignore>
        {entry.data.nextSlug
            ? <a href={getPostUrlBySlug(entry.data.nextSlug)} aria-label={`上一篇：${entry.data.nextTitle}`}
                 class="w-full font-bold overflow-hidden active:scale-95">
                <div class="rl-postnav btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center justify-start gap-4">
                    <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                    <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                        {entry.data.nextTitle}
                    </div>
                </div>
              </a>
            : <span class="hidden md:block flex-1" aria-hidden="true"></span>
        }

        {entry.data.prevSlug
            ? <a href={getPostUrlBySlug(entry.data.prevSlug)} aria-label={`下一篇：${entry.data.prevTitle}`}
                 class="w-full font-bold overflow-hidden active:scale-95">
                <div class="rl-postnav btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center justify-end gap-4">
                    <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                        {entry.data.prevTitle}
                    </div>
                    <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
                </div>
              </a>
            : <span class="hidden md:block flex-1" aria-hidden="true"></span>
        }
    </div>

</MainGridLayout>

<style is:global>
#post-container :nth-child(1) { animation-delay: calc(var(--content-delay) + 0ms) }
#post-container :nth-child(2) { animation-delay: calc(var(--content-delay) + 50ms) }
#post-container :nth-child(3) { animation-delay: calc(var(--content-delay) + 100ms) }
#post-container :nth-child(4) { animation-delay: calc(var(--content-delay) + 175ms) }
#post-container :nth-child(5) { animation-delay: calc(var(--content-delay) + 250ms) }
#post-container :nth-child(6) { animation-delay: calc(var(--content-delay) + 325ms) } 
</style>
