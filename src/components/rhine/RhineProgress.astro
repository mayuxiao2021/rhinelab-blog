---
interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props
const clean = (text: string) => text.replace(/\s*#\s*$/, '').trim()
const items = (headings ?? [])
  .filter(h => h.depth === 2 || h.depth === 3)
  .map(h => ({ ...h, text: clean(h.text) }))
---

{
  items.length >= 3 && (
    <nav class="rl-progress" id="rl-progress" aria-label="阅读进度">
      {items.map((h, i) => (
        <button
          class="rl-progress__tick"
          type="button"
          data-progress-target={h.slug}
          data-progress-no={String(i + 1).padStart(2, '0')}
          aria-label={`跳转到第 ${i + 1} 节：${h.text}`}
          title={h.text}
        />
      ))}
      <span class="rl-progress__pct" id="rl-progress-pct" aria-hidden="true">0%</span>
    </nav>
  )
}

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')

  function initRhineProgress() {
    // Swup 换页后清理上一页的滚动/尺寸监听，避免监听器累积
    const w = window as any
    if (typeof w.__rlProgressCleanup === 'function') w.__rlProgressCleanup()

    const rail = document.getElementById('rl-progress')
    if (!rail) return
    if (rail.dataset.bound === 'true') return
    rail.dataset.bound = 'true'

    const ticks = Array.from(rail.querySelectorAll<HTMLButtonElement>('.rl-progress__tick'))
    const pct = document.getElementById('rl-progress-pct')
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.rl-toc a[data-toc-target]'),
    )
    const sections = ticks
      .map((tick) => document.getElementById(tick.dataset.progressTarget || ''))
      .filter((el): el is HTMLElement => !!el)

    const setActive = (slug: string | null) => {
      for (const tick of ticks) {
        const active = tick.dataset.progressTarget === slug
        if (active) tick.setAttribute('aria-current', 'true')
        else tick.removeAttribute('aria-current')
      }
      for (const link of tocLinks) {
        const active = link.dataset.tocTarget === slug
        if (active) link.setAttribute('aria-current', 'true')
        else link.removeAttribute('aria-current')
      }
    }

    // 用「视口 28% 处的最后一个小节」判定当前进度：
    // 顶部未进入正文时无高亮，滚到底部时最后一节保持高亮（IntersectionObserver 的窄带方案会两头失效）
    const updateActive = () => {
      const probe = window.innerHeight * 0.28
      let next: string | null = null
      for (const section of sections) {
        if (section.getBoundingClientRect().top - probe <= 0) next = section.id
      }
      setActive(next)
    }

    const updatePct = () => {
      if (!pct) return
      const max = document.documentElement.scrollHeight - window.innerHeight
      const value = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0
      pct.textContent = `${Math.round(value)}%`
    }

    let raf = 0
    const onScroll = () => {
      if (raf) return
      raf = window.requestAnimationFrame(() => {
        raf = 0
        updateActive()
        updatePct()
      })
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
    updateActive()
    updatePct()

    const goTo = (slug: string) => {
      const el = document.getElementById(slug)
      if (!el) return
      el.scrollIntoView({
        behavior: reduced.matches ? 'auto' : 'smooth',
        block: 'start',
      })
    }

    rail.addEventListener('click', (event) => {
      const target = event.target as HTMLElement
      const tick = target.closest<HTMLButtonElement>('.rl-progress__tick')
      if (!tick) return
      goTo(tick.dataset.progressTarget || '')
    })

    w.__rlProgressCleanup = () => {
      window.removeEventListener('scroll', onScroll)
      window.removeEventListener('resize', onScroll)
      rail.dataset.bound = 'false'
    }

    rail.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key
      if (key !== 'ArrowDown' && key !== 'ArrowUp') return
      const current = ticks.findIndex((t) => t.getAttribute('aria-current') === 'true')
      const next = Math.min(
        ticks.length - 1,
        Math.max(0, current + (key === 'ArrowDown' ? 1 : -1)),
      )
      event.preventDefault()
      ticks[next]?.focus()
    })
  }

  initRhineProgress()
  document.addEventListener('astro:after-swap', initRhineProgress)
</script>
