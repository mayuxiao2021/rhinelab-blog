---
interface Props {
  class?: string
  size?: number
}

const { class: className, size = 28 } = Astro.props
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="1.5"></circle>
  <circle
    cx="24"
    cy="24"
    r="15"
    stroke="currentColor"
    stroke-width="1"
    stroke-dasharray="2 5"
    opacity=".65"></circle>
  <path
    d="M24 2.5v5.5M24 40v5.5M2.5 24H8M40 24h5.5"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"></path>
  <path
    d="M16.5 28.5 24 19.5l7.5 9"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="square"></path>
  <path
    d="M16.5 34.5 24 25.5l7.5 9"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="square"
    opacity=".5"></path>
  <circle cx="24" cy="24" r="1.6" fill="currentColor"></circle>
</svg>
